# Server
PORT=3001
# Secret shared between web proxy and server — protects POST /agents from random callers
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEPLOY_SECRET=
GROQ_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=groq
AGENT_WALLET_ADDRESS=
FACILITATOR_URL=https://x402.org/facilitator
PAYMENT_NETWORK=eip155:84532

# XMTP Agent (generate keys with: pnpm --filter agent gen:keys)
XMTP_ENV=dev
XMTP_WALLET_KEY=
XMTP_DB_ENCRYPTION_KEY=
SERVER_URL=http://localhost:3001

# World ID (from developer.worldcoin.org)
WORLD_SIGNING_KEY=
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_RP_ID=
NEXT_PUBLIC_WORLD_ENV=staging

# Web
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
NEXT_PUBLIC_XMTP_AGENT_ADDRESS=
FRONTEND_URL=http://localhost:3000
MURF_API_KEY=

# Twitter OAuth (create app at developer.twitter.com, OAuth 2.0)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Custom domain for subdomain routing (optional — needs wildcard DNS on Vercel)
# NEXT_PUBLIC_ROOT_DOMAIN=signet.app
